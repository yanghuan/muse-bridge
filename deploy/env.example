# /etc/muse-bridge/env  (chmod 600, owner muse-bridge or root)
# Bearer token authorizing callers of the bridge HTTP API.
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=change-me-to-a-random-token
# Where the bridge listens. Behind a reverse proxy / tailscale, keep localhost.
LISTEN_ADDR=127.0.0.1:8080
